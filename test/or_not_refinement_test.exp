(*
  Test to verify that refinements are NOT extracted from OR/NOT branches
  This should FAIL because the guard is inside an OR
*)

SCHEMA or_not_test;

TYPE int_set = SET OF INTEGER;
END_TYPE;

TYPE str_type = STRING;
END_TYPE;

TYPE mixed_select = SELECT
  (int_set,
   str_type);
END_TYPE;

(* Test 1: Guard inside OR - should FAIL
   The pattern is: (GUARD OR something) AND QUERY
   The guard doesn't necessarily hold when QUERY executes,
   so refinement should NOT happen, and QUERY on SELECT should fail.
   Note: >= 0 is always true, but test is designed to fail at compile time
*)
ENTITY test_guard_in_or;
  data : mixed_select;
  flag : BOOLEAN;
WHERE
  wr1: (('int_set' IN TYPEOF(data)) OR flag) AND 
       (SIZEOF(QUERY(x <* data | x > 0)) >= 0);
END_ENTITY;

(* Test 2: NOT with guard - should FAIL
   Pattern: NOT(NOT(GUARD)) AND QUERY
   Even though double negation is logically equivalent to GUARD,
   we should be conservative and not extract through NOT.
   Note: >= 0 is always true, but test is designed to fail at compile time
*)
ENTITY test_not_guard;
  data : mixed_select;
WHERE
  wr2: NOT(NOT('int_set' IN TYPEOF(data))) AND 
       (SIZEOF(QUERY(x <* data | x > 0)) >= 0);
END_ENTITY;

(* Test 3: Correct pattern - should PASS
   This is the correct pattern: GUARD AND QUERY
*)
ENTITY test_correct_pattern;
  data : mixed_select;
WHERE
  wr3: ('int_set' IN TYPEOF(data)) AND 
       (SIZEOF(QUERY(x <* data | x > 0)) >= 0);
END_ENTITY;

END_SCHEMA;
