ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('AP242 styled_item test file - exercises TREAT expression in WR3'),'2;1');
FILE_NAME('test_ap242_styled_item.stp','2026-02-09T14:00:00',('STEPcode Test'),('STEPcode Project'),'exp2cxx','STEPcode','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;

/* Context setup */
#1=APPLICATION_CONTEXT('mechanical design');
#2=PRODUCT_CONTEXT('',#1,'mechanical');
#3=PRODUCT('test_product','test_product','',(#2));
#4=PRODUCT_DEFINITION_FORMATION('v1','version 1',#3);
#5=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#6=PRODUCT_DEFINITION('design','',#4,#5);

/* Geometric context */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#15=(GEOMETRIC_REPRESENTATION_CONTEXT(3)
     GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))
     REPRESENTATION_CONTEXT('3D','3D'));

/* Simple geometric items for styling */
#20=CARTESIAN_POINT('origin',(0.0,0.0,0.0));
#21=DIRECTION('z-axis',(0.0,0.0,1.0));
#22=DIRECTION('x-axis',(1.0,0.0,0.0));
#23=AXIS2_PLACEMENT_3D('placement',#20,#21,#22);

/* Test Case 1: styled_item with geometric_representation_item */
/* A simple point as the styled item */
#30=CARTESIAN_POINT('test_point',(10.0,20.0,30.0));

/* Presentation style for the point */
#35=COLOUR_RGB('red',1.0,0.0,0.0);
#36=POINT_STYLE('',#35,SIZE_SELECT(.POSITIVE_LENGTH_MEASURE.,1.0));
#37=PRESENTATION_STYLE_ASSIGNMENT((#36));

/* styled_item wrapping the point - tests WR3 with geometric_representation_item */
#40=STYLED_ITEM('styled_point',(#37),#30);

/* Test Case 2: styled_item with set_representation_item */
/* Create a set of representation items */
#50=CARTESIAN_POINT('point1',(0.0,0.0,0.0));
#51=CARTESIAN_POINT('point2',(100.0,0.0,0.0));
#52=CARTESIAN_POINT('point3',(100.0,100.0,0.0));
#53=CARTESIAN_POINT('point4',(0.0,100.0,0.0));

/* Line segments forming a square */
#54=DIRECTION('dir1',(1.0,0.0,0.0));
#55=VECTOR('vec1',#54,100.0);
#56=LINE('line1',#50,#55);

#57=DIRECTION('dir2',(0.0,1.0,0.0));
#58=VECTOR('vec2',#57,100.0);
#59=LINE('line2',#51,#58);

#60=DIRECTION('dir3',(-1.0,0.0,0.0));
#61=VECTOR('vec3',#60,100.0);
#62=LINE('line3',#52,#61);

#63=DIRECTION('dir4',(0.0,-1.0,0.0));
#64=VECTOR('vec4',#63,100.0);
#65=LINE('line4',#53,#64);

/* Composite curve as a set_representation_item */
/* Uses the problematic TREAT expression in WR3 */
#70=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#56);
#71=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#59);
#72=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#62);
#73=COMPOSITE_CURVE_SEGMENT(.CONTINUOUS.,.T.,#65);
#74=COMPOSITE_CURVE('square',(#70,#71,#72,#73),.F.);

/* Style for the composite curve */
#80=COLOUR_RGB('blue',0.0,0.0,1.0);
#81=CURVE_STYLE('',#82,SIZE_SELECT(.POSITIVE_LENGTH_MEASURE.,2.0),#80);
#82=DRAUGHTING_PRE_DEFINED_CURVE_FONT('continuous');
#83=PRESENTATION_STYLE_ASSIGNMENT((#81));

/* styled_item with composite_curve */
/* This exercises the TREAT(item AS set_representation_item) in WR3 */
#90=STYLED_ITEM('styled_composite',(#83),#74);

/* Representation containing all styled items */
#100=SHAPE_REPRESENTATION('test_representation',(#23,#40,#90),#15);
#101=SHAPE_DEFINITION_REPRESENTATION(#6,#100);

ENDSEC;
END-ISO-10303-21;
