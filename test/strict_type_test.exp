(*
  Explicit test for invalid refinement type compatibility
*)

SCHEMA strict_type_test;

TYPE int_set = SET OF INTEGER;
END_TYPE;

TYPE real_set = SET OF REAL;
END_TYPE;

TYPE int_only_select = SELECT (int_set);
END_TYPE;

(* This should FAIL because real_set is not in int_only_select *)
ENTITY must_fail_invalid_refinement;
  data : int_only_select;
WHERE
  (* The guard is for real_set, which is NOT in int_only_select
     So the refinement should not happen, and the QUERY should fail
     because data remains as SELECT type *)
  wr1: ('real_set' IN TYPEOF(data)) AND (SIZEOF(QUERY(x <* data | x > 0.0)) >= 0);
END_ENTITY;

(* This should PASS because int_set IS in int_only_select *)
ENTITY must_pass_valid_refinement;
  data : int_only_select;
WHERE
  (* The guard is for int_set, which IS in int_only_select
     So the refinement should happen, and the QUERY should work *)
  wr1: ('int_set' IN TYPEOF(data)) AND (SIZEOF(QUERY(x <* data | x > 0)) >= 0);
END_ENTITY;

END_SCHEMA;
