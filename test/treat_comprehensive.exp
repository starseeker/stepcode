(*
  Test schema for TREAT built-in function and flow-sensitive type narrowing
  
  This schema tests:
  1. TREAT function with SELECT types
  2. Flow-sensitive type narrowing with TYPEOF guards
  3. QUERY expressions with type guards (AP242 pattern)
*)

SCHEMA treat_test;

-- A simple SET type
TYPE int_set = SET OF INTEGER;
END_TYPE;

TYPE str_type = STRING;
END_TYPE;

TYPE int_type = INTEGER;
END_TYPE;

-- A SELECT type that includes both aggregate and non-aggregate types
TYPE mixed_select = SELECT
  (int_set,
   str_type,
   int_type);
END_TYPE;

-- Test entity that uses TREAT to explicitly cast SELECT to SET type
ENTITY test_with_treat;
  data : mixed_select;
WHERE
  -- Using TREAT to explicitly cast SELECT to SET type
  wr1: SIZEOF(QUERY(x <* TREAT(data, int_set) | x > 0)) >= 0;
END_ENTITY;

-- Test entity that uses TYPEOF guard for type narrowing (AP242 pattern)
-- This tests flow-sensitive type narrowing: the guard proves data is int_set,
-- allowing QUERY to work on it
ENTITY test_with_typeof_guard;
  data : mixed_select;
WHERE
  -- Type guard followed by QUERY - narrowing should allow this
  -- Try without schema prefix first
  wr1: ('INT_SET' IN TYPEOF(data)) AND 
       (SIZEOF(QUERY(x <* data | x > 0)) >= 0);
END_ENTITY;

-- Test entity with multiple guards (should also work with narrowing)
ENTITY test_with_multiple_guards;
  data : mixed_select;
  other_data : mixed_select;
WHERE
  -- Multiple independent guards in the same expression
  wr1: (('INT_SET' IN TYPEOF(data)) AND (SIZEOF(QUERY(x <* data | x > 5)) = 0)) AND
       (('INT_SET' IN TYPEOF(other_data)) AND (SIZEOF(QUERY(y <* other_data | y < 0)) = 0));
END_ENTITY;

END_SCHEMA;
