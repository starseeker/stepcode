(*
  Test schema for TREAT built-in function and QUERY on SELECT types
  
  This schema tests:
  1. TREAT function with SELECT types
  2. QUERY expressions on SELECT types containing aggregate members
  3. Type casting from SELECT to specific member types
*)

SCHEMA treat_test;

-- A simple SET type
TYPE int_set = SET OF INTEGER;
END_TYPE;

TYPE str_type = STRING;
END_TYPE;

TYPE int_type = INTEGER;
END_TYPE;

-- A SELECT type that includes both aggregate and non-aggregate types
TYPE mixed_select = SELECT
  (int_set,
   str_type,
   int_type);
END_TYPE;

-- Test entity that uses TREAT
ENTITY test_with_treat;
  data : mixed_select;
WHERE
  -- Using TREAT to explicitly cast SELECT to SET type
  wr1: SIZEOF(QUERY(x <* TREAT(data, int_set) | x > 0)) >= 0;
END_ENTITY;

-- Test entity that uses QUERY directly on SELECT (no TREAT needed)
-- This works because stepcode now allows QUERY on SELECT types
-- that contain at least one aggregate member
ENTITY test_without_treat;
  data : mixed_select;
WHERE
  -- QUERY on SELECT type - works if at least one member is aggregate
  wr1: SIZEOF(QUERY(x <* data | x > 0)) >= 0;
END_ENTITY;

END_SCHEMA;
