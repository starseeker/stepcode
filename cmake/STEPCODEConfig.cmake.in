# STEPCODEConfig.cmake
# This file allows find_package(STEPCODE) to work with a CMake config-file package.
# It provides imported targets in the STEPCODE:: namespace.
#
# Usage:
#   find_package(STEPCODE REQUIRED)
#   target_link_libraries(myapp PRIVATE STEPCODE::stepcore STEPCODE::stepeditor
#                                       STEPCODE::stepdai STEPCODE::steputils)
#
# Schema libraries built at install time are also exported, e.g.:
#   target_link_libraries(myapp PRIVATE STEPCODE::sdai_ap203)
#
# For static libraries, use targets with the -static suffix, e.g.:
#   target_link_libraries(myapp PRIVATE STEPCODE::stepcore-static)
#
# Convenience targets (link to shared if available, otherwise static):
#   STEPCODE::steputils
#   STEPCODE::stepdai
#   STEPCODE::stepcore
#   STEPCODE::stepeditor
#   STEPCODE::steplazyfile
#   STEPCODE::express
#   STEPCODE::libexppp
#
# Schema libraries (if built and installed) are also available.
# Schema library names follow the pattern STEPCODE::sdai_<shortname>, e.g.:
#   STEPCODE::sdai_ap203
#   STEPCODE::sdai_ap214e3
# Use the -static suffix for static variants:
#   STEPCODE::sdai_ap203-static

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/STEPCODETargets.cmake")

# Provide convenience aliases for core libraries: when only static libs are
# installed, create an alias without the -static suffix so consumers can use
# STEPCODE::stepcore regardless.
set(_stepcode_libs steputils stepdai stepcore stepeditor steplazyfile express libexppp)
foreach(_lib ${_stepcode_libs})
  if(NOT TARGET STEPCODE::${_lib} AND TARGET STEPCODE::${_lib}-static)
    # Only static available - create a convenience alias without the -static suffix
    add_library(STEPCODE::${_lib} ALIAS STEPCODE::${_lib}-static)
  endif()
endforeach()
unset(_stepcode_libs)
unset(_lib)

# Create convenience aliases for schema libraries exported as -static only.
# Parse the targets file to discover all exported targets (avoids hard-coding
# schema names which are not known at template-generation time).
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/STEPCODETargets.cmake" _sc_target_lines
     REGEX "^# Create imported target STEPCODE::")
foreach(_sc_line ${_sc_target_lines})
  string(REGEX REPLACE "^# Create imported target " "" _sc_target "${_sc_line}")
  if(_sc_target MATCHES "^STEPCODE::(.+)-static$")
    set(_sc_base "${CMAKE_MATCH_1}")
    if(NOT TARGET STEPCODE::${_sc_base})
      add_library(STEPCODE::${_sc_base} ALIAS STEPCODE::${_sc_base}-static)
    endif()
  endif()
endforeach()
unset(_sc_target_lines)
unset(_sc_line)
unset(_sc_target)
unset(_sc_base)

check_required_components(STEPCODE)
